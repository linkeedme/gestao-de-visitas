# Token da API do Zaple. Fica APENAS no servidor — nunca prefixe com
# NEXT_PUBLIC_, porque ele dá acesso a todos os contatos e painéis da empresa.
ZAPLE_TOKEN=
ZAPLE_BASE_URL=https://api.wts.chat

# Painel de visitas no Zaple.
ZAPLE_PANEL_ID=

# Postgres do Supabase.
#
# DATABASE_URL: o "Transaction pooler" (porta 6543). É a que o app usa em
# produção — serverless abre e fecha conexão o tempo todo, e o pooler é o que
# impede isso de estourar o limite do projeto.
DATABASE_URL=
#
# DIRECT_URL: a conexão direta (porta 5432). Usada só pelas migrações, porque
# o pooler de transação não sustenta bem DDL.
DIRECT_URL=

# Segredo de assinatura do cookie de sessão. Gere com:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=

# Conexões por instância. Deixe em branco em produção (padrão 12).
# Em desenvolvimento com o Postgres embarcado (scripts/banco-local.mts), use 1:
# o PGlite serve tudo por uma conexão e multiplexa mal consultas concorrentes.
#
# Era 3, e três era o que travava: a tela de gestão pede oito consultas de uma
# vez, o que sobrava ia para uma fila sem prazo, e quem clicasse noutra tela
# entrava atrás da fila inteira da anterior.
DB_POOL_MAX=

# Janela, em milissegundos, que o pool de conexões pode ficar parado antes de
# ser trocado por um novo (padrão 10000). Existe porque a Vercel congela a
# função entre requisições e os sockets morrem durante a soneca. Cliques em
# sequência caem dentro da janela e reaproveitam a mesma conexão — é o que
# evita o travamento de tocar em duas coisas seguidas.
DB_OCIOSIDADE_MAX_MS=

# Prazos do caminho de uma requisição, todos em milissegundos. Ver src/lib/
# prazos.ts: o que importa neles é a ORDEM, e a regra é que o teto da tela seja
# o maior de todos, para que cada causa específica dispare com o próprio nome
# antes do teto genérico. Estavam invertidos, e por isso o registro só mostrava
# "passou de 8s" enquanto a causa real sumia.
#
# Abrir conexão (padrão 5000) e consulta no servidor (padrão 8000).
DB_CONECTAR_MS=
DB_CONSULTA_MS=
#
# Transação aberta e parada (padrão 9000).
DB_TRANSACAO_OCIOSA_MS=
#
# Chamadas ao Zaple: por tentativa (padrão 5000) e do conjunto, retentativas
# incluídas (padrão 10000). O fetch do Node não tem prazo nenhum por padrão.
ZAPLE_TIMEOUT_MS=
ZAPLE_ORCAMENTO_MS=
#
# O teto da tela (padrão 12000), última linha de defesa.
TELA_TETO_MS=

# Quanto tempo (ms) a resposta espera o espelho no CRM antes de seguir sem ele
# e terminar o envio depois da resposta (padrão 1500). A visita já está gravada
# no nosso Postgres quando isso roda — o Zaple é cópia.
SINCRONISMO_PRAZO_MS=

# Quanto tempo (ms) as listas que vêm do CRM valem em cache (padrão 300000 em
# todas). São listas de configuração: mudam quando alguém mexe no Zaple, o que
# é raro e nunca urgente. Sem cache, cada uma era uma ida à rede no caminho de
# renderizar uma tela.
ZAPLE_ETAPAS_TTL_MS=
ZAPLE_AGENTES_TTL_MS=
ZAPLE_CAMPOS_TTL_MS=

# Quanto tempo (ms) o botão de reprocessar a fila pode gastar antes de devolver
# o parcial (padrão 60000). O que não couber fica para o próximo toque, que
# continua de onde parou. Sem isto o laço não tinha fim previsível e podia
# passar dos 300s da Vercel — morrendo sem devolver nem a contagem parcial.
SINCRONISMO_ORCAMENTO_MS=
