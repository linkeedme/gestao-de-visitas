# Token da API do Zaple. Fica APENAS no servidor — nunca prefixe com
# NEXT_PUBLIC_, porque ele dá acesso a todos os contatos e painéis da empresa.
ZAPLE_TOKEN=
ZAPLE_BASE_URL=https://api.wts.chat

# Painel de visitas no Zaple.
ZAPLE_PANEL_ID=

# Postgres do Supabase.
#
# DATABASE_URL: o "Transaction pooler" (porta 6543). É a que o app usa em
# produção — serverless abre e fecha conexão o tempo todo, e o pooler é o que
# impede isso de estourar o limite do projeto.
DATABASE_URL=
#
# DIRECT_URL: a conexão direta (porta 5432). Usada só pelas migrações, porque
# o pooler de transação não sustenta bem DDL.
DIRECT_URL=

# Segredo de assinatura do cookie de sessão. Gere com:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=

# Conexões por instância. Deixe em branco em produção (padrão 3).
# Em desenvolvimento com o Postgres embarcado (scripts/banco-local.mts), use 1:
# o PGlite serve tudo por uma conexão e multiplexa mal consultas concorrentes.
DB_POOL_MAX=

# Janela, em milissegundos, que o pool de conexões pode ficar parado antes de
# ser trocado por um novo (padrão 10000). Existe porque a Vercel congela a
# função entre requisições e os sockets morrem durante a soneca. Cliques em
# sequência caem dentro da janela e reaproveitam a mesma conexão — é o que
# evita o travamento de tocar em duas coisas seguidas.
DB_OCIOSIDADE_MAX_MS=

# Tetos das chamadas ao Zaple, em milissegundos: por tentativa (padrão 8000) e
# do conjunto, retentativas incluídas (padrão 12000). O fetch do Node não tem
# prazo nenhum por padrão, e sem teto uma chamada sem resposta prende a
# requisição até o limite da Vercel.
ZAPLE_TIMEOUT_MS=
ZAPLE_ORCAMENTO_MS=

# Quanto tempo (ms) a resposta espera o espelho no CRM antes de seguir sem ele
# e terminar o envio depois da resposta (padrão 1500). A visita já está gravada
# no nosso Postgres quando isso roda — o Zaple é cópia.
SINCRONISMO_PRAZO_MS=

# Quanto tempo (ms) a lista de etapas do painel vale em cache (padrão 300000).
ZAPLE_ETAPAS_TTL_MS=
